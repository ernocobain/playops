{
  "name": "playops",
  "version": "0.0.0",
  "description": "Independent AI agent/harness for Google Play and Android application operations.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "playops": "dist/cli/index.js"
  },
  "files": [
    "dist/**/*.js",
    "config/playops.example.yaml",
    "docs/credentials.md",
    "docs/permissions-and-approvals.md",
    "docs/audit-log.md",
    "docs/release-pipeline.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:package": "node scripts/package-acceptance.mjs",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "google-play",
    "android",
    "ai-agent",
    "release-ops"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@googleapis/androidpublisher": "^42.1.0",
    "@googleapis/playdeveloperreporting": "^15.0.1",
    "google-auth-library": "^11.1.0",
    "yaml": "^2.9.1"
  }
}
